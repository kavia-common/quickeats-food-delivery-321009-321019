# QuickEats frontend environment variables (Create React App requires REACT_APP_ prefix)
#
# Preview environment:
# - The platform injects API_BASE and WS_URL (non-REACT_APP), but CRA only exposes REACT_APP_ vars.
# - So we recommend mirroring those into REACT_APP_API_BASE / REACT_APP_WS_URL when running locally.

# REST API base URL (FastAPI)
REACT_APP_API_BASE=http://localhost:3001

# Optional: backend URL alias
REACT_APP_BACKEND_URL=http://localhost:3001

# WebSocket URL for real-time order tracking (backend path is `/ws`)
REACT_APP_WS_URL=ws://localhost:3001/ws

# Frontend URL (optional for this UI)
REACT_APP_FRONTEND_URL=http://localhost:3000
